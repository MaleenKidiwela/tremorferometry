# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# Data / outputs
# NOTE: git cannot re-include a file whose PARENT DIR is excluded, so this must be `data/*`
# (not `data/`) for the negations below to take effect.
data/*
# small, non-reproducible-without-the-fleet inputs that the joint 4-D inversion needs:
!data/*_causality_cert.csv
!data/broadband_fleet_order.csv
!data/candidate_stations_post2020.csv
!data/cas_slab2_input_04-18.csv
!data/station_slab2_depth.csv
!data/*.txt
# LFE-feature side-exploration: ship code+docs+figures, not the large reproducible products
lfe_features/data/
lfe_features/models/
lfe_features/__pycache__/
*.mseed
*.sac
*.h5
*.hdf5
*.npy
*.npz
figures/*
!figures/smoke_*.png
!figures/station_2to4/
!figures/station_2to4/*
outputs/

# Generated tomography products + interactive map (reproducible from fault_tomography/ code)
fault_tomography/*.html
fault_tomography/*.json
fault_tomography/**/*.parquet
fault_tomography/data_assembly/*.csv
fault_tomography/inversion/*.npz

# Catalog CSVs are reproducible from PNSN API + Bostock supplement;
# don't ship the data, just the code that fetches it.
catalogs/*.csv
catalogs/*.parquet
# NOTE: gitignore has NO trailing comments -- a `# ...` after a pattern becomes part of the
# pattern and silently matches nothing.
# pnsn_tremor_cascadia_full.csv (55 MB) is REQUIRED by invert_dvv_4d.py (ETS phase split), so it
# IS shipped despite its size (under GitHub's 100 MB hard limit; over the 50 MB warning threshold).
!catalogs/pnsn_tremor_cascadia_full.csv

# nested git repo (cloned paper source) -- would commit as a broken gitlink/submodule
catalogs/ducellier_catalog/

# The ASSEMBLED inversion products ARE the reproduction set: finalized dv/v tensor
# (pair_months.parquet), the forward operator (G.npz) and the joint-inversion result
# (inversion_4d.npz). Small (tens of MB). Must come AFTER the *.npz / *.parquet rules above.
!fault_tomography/inversion/res_catalog*/**
fault_tomography/inversion/res_catalog*/**/*.mp4
fault_tomography/inversion/res_catalog*/**/*.gif
fault_tomography/inversion/res_catalog*/.ipynb_checkpoints/

# scratch notebooks
Untitled.ipynb
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# transient pipeline run logs
logs/
fault_tomography/**/*.gif
fault_tomography/**/*.mp4

# Local Claude config (do not commit)
.claude/settings.local.json
figures/station_2to4/.ipynb_checkpoints/
